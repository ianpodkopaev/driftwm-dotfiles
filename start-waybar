#!/usr/bin/env bash
# start-waybar — launch waybar on the active WM's SELF-CONTAINED config.
#   driftwm  ->  $HOME/.config/driftwm/waybar
#   hyprland ->  $HOME/.config/hypr/waybar
# Picks the WM from the running compositor; driftwm is the default.
set -uo pipefail
THEME="Dusky-07_minimal_h.css"     # active theme (same name in both dirs)
X="$HOME/.config"

pick() {
  for i in 0 1 2 3 4; do
    pgrep -x driftwm  >/dev/null && { echo driftwm;  return 0; }
    pgrep -x hyprland >/dev/null && { echo hyprland; return 0; }
    sleep 0.5
  done
  echo driftwm   # default = primary WM
}

wm="$(pick)"
echo "waybar -> $wm  ($X/$wm/waybar/config)"

# driftwm: push bookmark changes to the bar instead of polling (SIGRTMIN+12)
pkill -f "$X/driftwm/waybar/bookmark-watch" 2>/dev/null
if [ "$wm" = driftwm ]; then
  "$X/driftwm/waybar/bookmark-watch" >/dev/null 2>&1 &
fi

exec waybar --config "$X/$wm/waybar/config" \
           --style  "$X/$wm/waybar/style/$THEME"
