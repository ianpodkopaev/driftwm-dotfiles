/* Dusky port | layout base */
{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    "$HOME/.config/waybar/ModulesVertical",
    "$HOME/.config/waybar/UserModules",
    "$HOME/.config/waybar/ModulesDusky",
    "$HOME/.config/waybar/dusky/ov_07_minimal_h",
  ],

  "battery": {"format": "{icon} {capacity}", "format-charging": "\uf0e7 {capacity}", "format-icons": ["\udb80\udc8e", "\udb80\udc7a", "\udb80\udc7b", "\udb80\udc7c", "\udb80\udc7d", "\udb80\udc7e", "\udb80\udc7f", "\udb80\udc80", "\udb80\udc81", "\udb80\udc82", "\udb80\udc79"], "interval": 5, "tooltip-format": "{timeTo}\nHealth: {health}%"},
  "bluetooth": {"format": "\udb80\udcaf", "format-disabled": "\udb80\udcb2", "format-connected": "\udb80\udcb1 {num_connections}", "format-connected-battery": "\udb80\udcb1 {device_battery_percentage}%", "tooltip-format": "{controller_alias}\n{controller_address}\n\n{device_enumerate}", "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}", "tooltip-format-enumerate-connected": "\udb80\udcb1 {device_alias}", "tooltip-format-enumerate-connected-battery": "\udb80\udcb1 {device_alias} ({device_battery_percentage}%)", "on-click": "dusky-run blueman-manager", "on-click-right": "dusky-run kitty --class bluetui -e bluetui"},
  "clock": {"format": "{:%I:%M}", "tooltip-format": "<tt>{calendar}</tt>", "on-click": "dusky-run gnome-clocks", "interval": 60, "calendar": {"mode": "year", "mode-mon-col": 3, "weeks-pos": "right", "on-scroll": 1, "format": {"months": "<span color='#ffb786'><b>{}</b></span>", "days": "<span color='#e2e2e2'>{}</span>", "weeks": "<span color='#c9ca93'>W{}</span>", "weekdays": "<span color='#ffb786'><b>{}</b></span>", "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"}}, "actions": {"on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down"}},
  "cpu": {"format": "\uec19 {usage}", "interval": 2, "on-click": "dusky-run kitty --class htop -e htop", "tooltip-format": "CPU: {usage}%", "states": {"critical": 80}},
  "fixed-center": true,
  "height": 32,
  "layer": "top",
  "margin-bottom": 5,
  "margin-left": 4,
  "margin-right": 4,
  "margin-top": 5,
  "memory": {"format": "\uf080 {percentage}", "interval": 2, "on-click": "dusky-run kitty --class dusky_disk_monitor_io.py -e $HOME/.local/bin/dusky/drives/dusky_disk_monitor_io.py", "tooltip-format": "Used: {used}GiB", "states": {"critical": 80}},
  "network": {"format-wifi": "\udb82\udd28", "format-ethernet": "\udb80\ude00", "format-disconnected": "\udb82\udd2d", "format-linked": "\udb80\ude01", "tooltip-format-wifi": "\udb82\udd28 {essid}\n\udb85\udc7d {signalStrength}%\n\udb82\ude5f {ipaddr}", "tooltip-format-ethernet": "\udb80\ude00 Ethernet\n\udb82\ude5f {ipaddr}", "tooltip-format-disconnected": "\udb82\udd2d Disconnected", "on-click": "foot --app-id=dusky_tui python $HOME/.local/bin/dusky/dusky_tui/python/main/main.py $HOME/.local/bin/dusky/network_manager/tui_dusky_network.py"},
  "position": "top",
  "pulseaudio": {"format": "{icon} ", "format-muted": "\udb81\udd81", "on-click": "dusky-run pavucontrol", "format-icons": ["\uf026", "\uf027", "\uf028"], "tooltip-format": "Volume: {volume}%"},
  "reload_style_on_change": true,
  "spacing": 0,
  "modules-left": ["group/clock-drawer", "group/notif-drawer"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["group/audio-drawer", "group/battery-drawer", "custom/power"],
}