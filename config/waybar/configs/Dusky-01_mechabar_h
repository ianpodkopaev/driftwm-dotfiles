/* Dusky port | layout base */
{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    "$HOME/.config/waybar/ModulesVertical",
    "$HOME/.config/waybar/UserModules",
    "$HOME/.config/waybar/ModulesDusky",
    "$HOME/.config/waybar/dusky/ov_01_mechabar_h",
  ],

  "backlight": {"format": "{icon} {percent}%", "format-icons": ["\ue38d", "\ue3d3", "\ue3d1", "\ue3cf", "\ue3ce", "\ue3cd", "\ue3ca", "\ue3c8", "\ue39b"], "on-click": "dusky-run $HOME/.local/bin/dusky/dusky_system/quickpanal/dusky_quickpanal.py", "on-click-right": "dusky-run $HOME/.local/bin/dusky/dusky_system/quickpanal/dusky_quickpanal.py", "on-scroll-up": "brightnessctl set +5%", "on-scroll-down": "brightnessctl set 5%-", "tooltip": false},
  "battery": {"states": {"warning": 20, "critical": 10}, "format": "{icon} {capacity}%", "format-time": "{H}h {M}min", "format-icons": ["\udb80\udc8e", "\udb80\udc7b", "\udb80\udc7c", "\udb80\udc7d", "\udb80\udc7e", "\udb80\udc7f", "\udb80\udc80", "\udb80\udc81", "\udb80\udc82", "\udb80\udc79"], "format-charging": "\udb80\ude41 {capacity}%", "tooltip-format": "<b>Discharging</b>: {time}\n<b>Power Draw</b>: {power:.2f} W", "tooltip-format-charging": "<b>Charging</b>: {time}\n<b>Power Input</b>: {power:.2f} W", "events": {"on-discharging-warning": "notify-send 'Battery Low (20%)' -u critical -i 'battery-020' -h string:x-canonical-private-synchronous:battery", "on-discharging-critical": "notify-send 'Battery Critical (10%)' -u critical -i 'battery-010' -h string:x-canonical-private-synchronous:battery", "on-charging-100": "notify-send 'Battery Full (100%)' -i 'battery-100-charged' -h string:x-canonical-private-synchronous:battery"}},
  "bluetooth": {"format": "\udb80\udcaf", "format-disabled": "\udb80\udcb2", "format-off": "\udb80\udcb2", "format-on": "\udb80\udcb0", "format-connected": "\udb80\udcb1", "on-click": "dusky-run blueman-manager", "on-click-right": "dusky-run kitty --class bluetui -e bluetui", "tooltip-format": "Device Addr: {device_address}", "tooltip-format-disabled": "Bluetooth Disabled", "tooltip-format-off": "Bluetooth Off", "tooltip-format-on": "Bluetooth Disconnected", "tooltip-format-connected": "Device: {device_alias}", "tooltip-format-enumerate-connected": "Device: {device_alias}", "tooltip-format-connected-battery": "Device: {device_alias}\nBattery: {device_battery_percentage}%", "tooltip-format-enumerate-connected-battery": "Device: {device_alias}\nBattery: {device_battery_percentage}%"},
  "clock#date": {"format": "\udb83\ude17 {:%m-%d}", "tooltip-format": "<tt>{calendar}</tt>", "calendar": {"mode": "year", "mode-mon-col": 3, "weeks-pos": "right", "on-scroll": 1, "format": {"months": "<span color='#ffb786'><b>{}</b></span>", "days": "<span color='#e2e2e2'>{}</span>", "weeks": "<span color='#c9ca93'>W{}</span>", "weekdays": "<span color='#ffb786'><b>{}</b></span>", "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"}}, "actions": {"on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down"}},
  "clock#time": {"format": "{:%H:%M}", "tooltip-format": "<b>Standard Time</b>: {:%H:%M}"},
  "cpu": {"interval": 10, "format": "\udb80\udf5b {usage}%", "format-warning": "\udb80\udc28 {usage}%", "format-critical": "\udb80\udc28 {usage}%", "states": {"warning": 75, "critical": 90}, "tooltip": false},
  "height": 0,
  "layer": "top",
  "margin": 0,
  "memory": {"interval": 10, "format": "\udb81\ude1a {percentage}%", "format-warning": "\udb80\udc27 {percentage}%", "format-critical": "\udb80\udc27 {percentage}%", "on-click": "dusky-run kitty --class dusky_disk_monitor_io -e python \"$HOME/.local/bin/dusky/drives/dusky_disk_monitor_io.py\"", "states": {"warning": 75, "critical": 90}, "tooltip-format": "Memory Used: {used:0.0f}/{total:0.0f} GB"},
  "mode": "dock",
  "network": {"interval": 10, "format": "\udb82\udd28", "format-ethernet": "\udb80\ude00", "format-wifi": "{icon}", "format-disconnected": "\udb82\udd2f", "format-disabled": "\udb82\udd2e", "format-icons": ["\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28"], "on-click": "foot --app-id=dusky_tui python $HOME/.local/bin/dusky/dusky_tui/python/main/main.py $HOME/.local/bin/dusky/network_manager/tui_dusky_network.py", "on-click-right": "nmcli radio wifi off && notify-send 'Turned OFF WiFi'", "tooltip-format": "<b>Gateway</b>: {gwaddr}", "tooltip-format-ethernet": "<b>Interface</b>: {ifname}", "tooltip-format-wifi": "<b>Network</b>: {essid}\n<b>IP Addr</b>: {ipaddr}/{cidr}\n<b>Strength</b>: {signalStrength}%\n<b>Frequency</b>: {frequency} GHz\n<b>Up</b>: {bandwidthUpBytes}  <b>Down</b>: {bandwidthDownBytes}", "tooltip-format-disconnected": "Wi-Fi Disconnected", "tooltip-format-disabled": "Wi-Fi Disabled"},
  "position": "top",
  "pulseaudio#input": {"format": "{format_source}", "format-source": "\udb80\udf6c {volume}%", "format-source-muted": "\udb80\udf6d {volume}%", "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle", "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%", "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%", "tooltip-format": "<b>Input Device</b>: {desc}"},
  "pulseaudio#output": {"format": "{icon} {volume}%", "format-muted": "{icon} {volume}%", "format-icons": {"default": ["\udb81\udd7f", "\udb81\udd80", "\udb81\udd7e"], "default-muted": "\udb81\udf5f", "headphone": "\udb80\udecb", "headphone-muted": "\udb81\udfce", "headset": "\udb80\udece", "headset-muted": "\udb80\uded0"}, "on-click": "dusky-run pavucontrol", "on-click-right": "dusky-run kitty --class cava -e cava", "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle", "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%", "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%", "tooltip-format": "<b>Output Device</b>: {desc}\n\nLMB: Pavucontrol\nRMB: Cava\nMMB: Mute Toggle\nScroll: Volume"},
  "reload_style_on_change": true,
  "spacing": 0,
  "tooltip": true,
  "tray": {"icon-size": 15, "spacing": 6, "show-passive-items": true},
  "width": 0,
  "modules-left": ["group/user", "custom/right_div#1", "hyprland/workspaces", "custom/notifications", "custom/right_div#1"],
  "modules-center": ["custom/left_div#2", "custom/weather", "custom/left_div#3", "memory", "custom/left_div#4", "cpu", "custom/left_inv#1", "custom/left_div#5", "custom/distro", "custom/right_div#2", "custom/right_inv#1", "clock#time", "custom/right_div#3", "clock#date", "custom/right_div#4", "bluetooth", "network", "group/net-speed-drawer", "group/updates-drawer", "custom/right_div#5"],
  "modules-right": ["custom/left_div#2", "group/pulseaudio", "custom/left_div#3", "custom/left_div#4", "group/backlight-drawer", "group/power-drawer"],
}