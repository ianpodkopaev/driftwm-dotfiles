/* Dusky port | layout base */
{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    "$HOME/.config/waybar/ModulesVertical",
    "$HOME/.config/waybar/UserModules",
    "$HOME/.config/waybar/ModulesDusky",
    "$HOME/.config/waybar/dusky/ov_08_minimal_v",
  ],

  "backlight": {"justify": "center", "align": 0.5, "device": "intel_backlight", "format": "{icon}\n{percent}", "format-icons": ["\ue38d", "\ue3d4", "\ue3d3", "\ue3d2", "\ue3d1", "\ue3d0", "\ue3cf", "\ue3ce", "\ue3cd", "\ue3cc", "\ue3cb", "\ue3ca", "\ue3c9", "\ue3c8", "\ue39b"], "tooltip": true, "tooltip-format": "LMB: Brightness Slider\nRMB: hyprsunset Slider\nMMB: Shaders", "on-click": "dusky-run \"$HOME/.local/bin/dusky/dusky_system/quickpanal/dusky_quickpanal.py\"", "on-click-right": "dusky-run \"$HOME/.local/bin/dusky/dusky_system/quickpanal/dusky_quickpanal.py\"", "on-click-middle": "dusky-run \"$HOME/.local/bin/dusky/rofi/shader_menu.sh\"", "on-scroll-up": "brightnessctl set +5%", "on-scroll-down": "brightnessctl set 5%-", "min-length": 4, "interval": 60},
  "battery": {"justify": "center", "format": "{icon}\n{capacity}", "format-charging": "\uf0e7\n{capacity}", "format-icons": ["\udb80\udc8e", "\udb80\udc7a", "\udb80\udc7b", "\udb80\udc7c", "\udb80\udc7d", "\udb80\udc7e", "\udb80\udc7f", "\udb80\udc80", "\udb80\udc81", "\udb80\udc82", "\udb80\udc79"], "interval": 5, "tooltip-format": "{timeTo}\nHealth: {health}%"},
  "bluetooth": {"justify": "center", "align": 0.5, "format": "\uf294", "format-disabled": "\udb80\udcb2", "format-connected": "\uf294", "tooltip-format": "Devices connected: {num_connections}", "on-click": "dusky-run blueman-manager", "on-click-right": "dusky-run kitty --class bluetui -e bluetui"},
  "clock": {"justify": "center", "format": "{:%I\n%M}", "tooltip-format": "<tt>{calendar}</tt>", "on-click": "dusky-run gnome-clocks", "interval": 60, "calendar": {"mode": "year", "mode-mon-col": 3, "weeks-pos": "right", "on-scroll": 1, "format": {"months": "<span color='#ffb786'><b>{}</b></span>", "days": "<span color='#e2e2e2'>{}</span>", "weeks": "<span color='#c9ca93'>W{}</span>", "weekdays": "<span color='#ffb786'><b>{}</b></span>", "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"}}, "actions": {"on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down"}},
  "cpu": {"justify": "center", "format": "\uec19\n{usage}", "interval": 2, "on-click": "dusky-run kitty --class htop -e htop", "tooltip-format": "CPU: {usage}%", "states": {"critical": 80}},
  "fixed-center": true,
  "layer": "top",
  "margin-bottom": 5,
  "margin-left": 4,
  "margin-right": 4,
  "margin-top": 5,
  "memory": {"justify": "center", "format": "\uf080\n{percentage}", "interval": 2, "on-click": "dusky-run kitty --class dusky_disk_monitor_io.py -e $HOME/.local/bin/dusky/drives/dusky_disk_monitor_io.py", "tooltip-format": "Used: {used}GiB", "states": {"critical": 80}},
  "position": "right",
  "pulseaudio": {"justify": "center", "format": "{icon}\n{volume}", "format-muted": "\udb81\udd81", "on-click": "dusky-run pavucontrol", "format-icons": ["\uf026", "\uf027", "\uf028"], "tooltip-format": "Volume: {volume}%"},
  "reload_style_on_change": true,
  "spacing": 0,
  "temperature": {"justify": "center", "thermal-zone": 6, "format": "\uf2c9\n{temperatureC}", "critical-threshold": 80, "format-critical": "\ud83d\udd25\n{temperatureC}", "tooltip-format": "Temp: {temperatureC}\u00b0C"},
  "width": 30,
  "modules-left": ["group/clock-drawer"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["group/media-drawer", "battery", "group/power-drawer"],
}