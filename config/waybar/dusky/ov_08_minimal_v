// 08_minimal_v variant overrides
{
  "group/clock-drawer": {"orientation": "vertical", "drawer": {"transition-duration": 300, "children-class": "clock-drawer", "transition-left-to-right": true}, "modules": ["clock", "custom/notification", "custom/updates"]},
  "group/power-drawer": {"orientation": "vertical", "drawer": {"transition-duration": 300, "children-class": "power-drawer", "transition-left-to-right": false}, "modules": ["custom/power", "custom/inhibit-suspend"]},
  "hyprland/workspaces": {"format": "", "on-click": "activate", "sort-by": "number", "persistent-workspaces": {}, "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"},
  "custom/notification": {"justify": "center", "align": 0.5, "tooltip-format": "Left Click: Launch Mako\nMiddle Click: Clear All\nRight Click: Do Not Disturb", "format": "{}", "return-type": "json", "exec-if": "which makoctl", "exec": "$HOME/.local/bin/dusky/waybar/mako.sh --vertical", "interval": 2, "on-click": "$HOME/.local/bin/dusky/rofi/rofi_mako.sh", "on-click-middle": "$HOME/.local/bin/dusky/waybar/mako.sh --clear && pkill -RTMIN+8 waybar", "on-click-right": "makoctl mode -t do-not-disturb && pkill -RTMIN+8 waybar", "signal": 8, "escape": true},
  "custom/updates": {"justify": "center", "align": 0.5, "exec": "tail -F ~/.config/dusky/settings/waybar_update_counter_v 2>/dev/null", "return-type": "json", "format": "{}", "tooltip": true, "on-click": "dusky-run kitty --class system_update.sh --hold -e $HOME/.local/bin/dusky/update_dusky/system_update.sh --all"},
  "custom/network": {"justify": "center", "return-type": "json", "exec": "$HOME/.local/bin/dusky/waybar/network/network_meter_calling.sh --vertical", "interval": 1, "on-click": "foot --app-id=dusky_tui python $HOME/.local/bin/dusky/dusky_tui/python/main/main.py $HOME/.local/bin/dusky/network_manager/tui_dusky_network.py", "on-click-right": "nmcli radio wifi on", "on-click-middle": "nmcli radio wifi off"},
  "custom/power": {"justify": "center", "format": "\uf011", "tooltip": true, "tooltip-format": "Power Menu\n RMB - Control Center", "on-click": "dusky-run $HOME/.local/bin/dusky/wlogout/wlogout_scale.sh", "on-click-right": "dusky-run python3 $HOME/.local/bin/dusky/dusky_system/control_center/dusky_control_center.py"},
  "custom/inhibit-suspend": {"justify": "center", "align": 0.5, "format": "{}", "exec": "if pgrep -x 'hypridle' > /dev/null;\nthen echo '{\"text\": \"\udb80\udf3e\", \"tooltip\": \"Suspend is enabled.\\nClick to disable.\", \"class\": \"enabled\"}';\nelse echo '{\"text\": \"\uf52a\", \"tooltip\": \"Suspend is disabled.\\nClick to enable.\", \"class\": \"disabled\"}';\nfi", "return-type": "json", "interval": 5, "signal": 9, "on-click": "dusky-run \"$HOME/.local/bin/dusky/waybar/toggle_hypridle.sh\"", "escape": true},
}