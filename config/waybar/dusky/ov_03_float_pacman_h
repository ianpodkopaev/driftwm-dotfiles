// 03_float_pacman_h variant overrides
{
  "group/network-drawer": {"orientation": "horizontal", "drawer": {"transition-duration": 400, "children-class": "network-drawer", "click-to-reveal": false, "transition-left-to-right": true}, "modules": ["custom/net-speed", "network"]},
  "group/updates-drawer": {"orientation": "horizontal", "drawer": {"transition-duration": 400, "children-class": "updates-drawer", "click-to-reveal": false, "transition-left-to-right": true}, "modules": ["custom/updates-trigger", "custom/updates"]},
  "group/power-drawer": {"orientation": "horizontal", "drawer": {"transition-duration": 400, "children-class": "power-drawer", "click-to-reveal": false, "transition-left-to-right": false}, "modules": ["custom/power", "custom/inhibit-suspend"]},
  "custom/launcher": {"format": "\udb80\udf3d", "on-click": "python3 $HOME/.local/bin/dusky/dusky_system/control_center/dusky_control_center.py", "on-click-right": "gdbus call --session --dest org.dusky.quickpanal --object-path /org/dusky/quickpanal --method org.freedesktop.Application.Activate '{}'", "tooltip-format": "Control Center"},
  "hyprland/workspaces": {"format": "{icon}", "on-click": "activate", "all-outputs": true, "sort-by": "number", "persistent-workspaces": {"1": [], "2": [], "3": [], "4": [], "5": []}, "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "format-icons": {"active": "\udb82\udfaf", "default": "\udb80\udea0", "persistent": "\udb80\udea0"}},
  "custom/updates-trigger": {"format": "\uf063", "exec": "echo '\uf063'", "exec-if": "grep -q '\"class\":\"pending\"' ~/.config/dusky/settings/waybar_update_counter_h 2>/dev/null", "interval": 5, "tooltip": false},
  "custom/updates": {"exec": "tail -F ~/.config/dusky/settings/waybar_update_counter_h 2>/dev/null", "return-type": "json", "format": "{}", "tooltip": true, "on-click": "dusky-run kitty --class system_update.sh --hold -e $HOME/.local/bin/dusky/update_dusky/system_update.sh --all"},
  "custom/notification": {"justify": "center", "align": 0.5, "tooltip-format": "Left Click: Launch Mako\nMiddle Click: Clear All\nRight Click: Do Not Disturb", "format": "{}", "return-type": "json", "exec-if": "which makoctl", "exec": "$HOME/.local/bin/dusky/waybar/mako.sh --horizontal", "interval": 2, "on-click": "$HOME/.local/bin/dusky/rofi/rofi_mako.sh", "on-click-middle": "$HOME/.local/bin/dusky/waybar/mako.sh --clear && pkill -RTMIN+8 waybar", "on-click-right": "makoctl mode -t do-not-disturb && pkill -RTMIN+8 waybar", "signal": 8, "escape": true},
  "custom/inhibit-suspend": {"format": "{}", "exec": "if pgrep -x 'hypridle' > /dev/null; then echo '{\"text\": \"\udb81\udeca\", \"tooltip\": \"Auto-suspend ENABLED\\nClick to disable hypridle\", \"class\": \"enabled\"}'; else echo '{\"text\": \"\udb80\udd76\", \"tooltip\": \"Auto-suspend DISABLED\\nClick to enable hypridle\", \"class\": \"disabled\"}'; fi", "return-type": "json", "interval": 5, "signal": 9, "on-click": "dusky-run $HOME/.local/bin/dusky/waybar/toggle_hypridle.sh", "escape": true},
  "custom/power": {"format": "\u23fb", "on-click": "dusky-run $HOME/.local/bin/dusky/wlogout/wlogout_scale.sh", "tooltip-format": "Power Menu"},
}