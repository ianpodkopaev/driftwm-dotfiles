// 01_mechabar_h variant overrides
{
  "hyprland/workspaces": {"format": "{icon}", "format-icons": {"active": "\ueaab", "default": "\ueb8a"}, "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'", "cursor": true},
  "custom/weather": {"format": "{}", "exec": "python3 $HOME/.local/bin/dusky/waybar/weather.py", "interval": 1800, "return-type": "json"},
  "custom/inhibit-suspend": {"format": "{}", "exec": "if pgrep -x 'hypridle' > /dev/null; then echo '{\"text\": \"\udb83\udfaa\", \"tooltip\": \"Idle enabled. Click to disable.\", \"class\": \"enabled\"}'; else echo '{\"text\": \"\udb80\udd76\", \"tooltip\": \"Idle disabled. Click to enable.\", \"class\": \"disabled\"}'; fi", "return-type": "json", "interval": 5, "signal": 9, "on-click": "dusky-run $HOME/.local/bin/dusky/waybar/toggle_hypridle.sh", "escape": true},
  "group/updates-drawer": {"orientation": "horizontal", "drawer": {"transition-duration": 400, "children-class": "updates-drawer", "click-to-reveal": false, "transition-left-to-right": false}, "modules": ["custom/updates-trigger", "custom/updates"]},
  "custom/updates-trigger": {"format": "\uf063", "exec": "echo '\uf063'", "exec-if": "grep -q '\"class\":\"pending\"' ~/.config/dusky/settings/waybar_update_counter_h 2>/dev/null", "interval": 5, "tooltip": false},
  "custom/updates": {"exec": "tail -F ~/.config/dusky/settings/waybar_update_counter_h 2>/dev/null", "return-type": "json", "format": "{}", "tooltip": true, "on-click": "dusky-run kitty --class system_update.sh --hold -e $HOME/.local/bin/dusky/update_dusky/system_update.sh --all"},
  "group/backlight-drawer": {"orientation": "horizontal", "drawer": {"transition-left-to-right": false}, "modules": ["battery", "backlight"]},
  "group/power-drawer": {"orientation": "horizontal", "drawer": {"transition-duration": 400, "children-class": "power-drawer", "click-to-reveal": false, "transition-left-to-right": false}, "modules": ["custom/power", "custom/inhibit-suspend"]},
  "custom/power": {"format": "\udb82\udd04", "on-click": "dusky-run $HOME/.local/bin/dusky/wlogout/wlogout_scale.sh", "tooltip-format": "Power Menu"},
}