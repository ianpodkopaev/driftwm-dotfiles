/* Dusky port | layout base */
{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    "$HOME/.config/waybar/ModulesVertical",
    "$HOME/.config/waybar/UserModules",
    "$HOME/.config/waybar/ModulesDusky",
    "$HOME/.config/waybar/dusky/ov_03_float_pacman_h",
  ],

  "backlight": {"format": "{icon} {percent}", "tooltip-format": "Brightness: {percent}%\n\n LMB  Brightness\n RMB  Night Light\n MMB  Shaders", "on-click": "dusky-run $HOME/.local/bin/dusky/dusky_system/quickpanal/dusky_quickpanal.py", "on-click-right": "dusky-run $HOME/.local/bin/dusky/dusky_system/quickpanal/dusky_quickpanal.py", "on-click-middle": "dusky-run $HOME/.local/bin/dusky/rofi/shader_menu.sh", "on-scroll-up": "brightnessctl set +5%", "on-scroll-down": "brightnessctl set 5%-", "format-icons": ["\udb80\udcde", "\udb80\udcdf", "\udb80\udce0"]},
  "battery": {"format": "{icon} {capacity}%", "format-alt": "{icon} {capacity}% {power:.1f}W", "format-charging": "\udb80\udc84 {capacity}%", "format-plugged": "\udb80\udc84 {capacity}%", "format-full": "\udb85\udfe2", "format-warning": "{icon} {capacity}%", "format-critical": "\udb80\udc83 {capacity}%", "format-icons": ["\udb80\udc8e", "\udb80\udc7a", "\udb80\udc7b", "\udb80\udc7c", "\udb80\udc7d", "\udb80\udc7e", "\udb80\udc7f", "\udb80\udc80", "\udb80\udc81", "\udb80\udc82", "\udb80\udc79"], "interval": 5, "states": {"warning": 30, "critical": 15}, "tooltip-format": "{timeTo}\nHealth: {health}%\nPower Draw: {power:.2f} W\nCycles: {cycles}\n\nLMB: Toggle Format\nRMB: Timeout Settings", "on-click-right": "dusky-run kitty --class dusky_hypridle.sh -e $HOME/.local/bin/dusky/hypridle/dusky_hypridle.sh"},
  "clock": {"format": "{:%I:%M %p}", "format-alt": "\udb80\udced {:%A, %B %d}", "tooltip-format": "<tt>{calendar}</tt>", "calendar": {"mode": "year", "mode-mon-col": 3, "weeks-pos": "right", "on-scroll": 1, "format": {"months": "<span color='#ffb786'><b>{}</b></span>", "days": "<span color='#e2e2e2'>{}</span>", "weeks": "<span color='#c9ca93'>W{}</span>", "weekdays": "<span color='#ffb786'><b>{}</b></span>", "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"}}, "actions": {"on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down"}},
  "cpu": {"interval": 2, "format": "\udb80\udf5b {usage}%", "on-click": "kitty -e btop", "states": {"warning": 70, "critical": 90}},
  "exclusive": true,
  "gtk-layer-shell": true,
  "height": 43,
  "layer": "top",
  "margin-left": 15,
  "margin-right": 15,
  "margin-top": 3,
  "memory": {"format": "\udb80\udf5b {percentage}%", "format-alt": "\udb80\udf5b {used:0.1f}G", "interval": 3, "on-click-right": "dusky-run kitty --class dusky_disk_monitor_io -e python $HOME/.local/bin/dusky/drives/dusky_disk_monitor_io.py", "tooltip-format": "RAM: {used:0.2f} GiB / {total:0.2f} GiB ({percentage}%)\nAvailable: {avail:0.2f} GiB\nSwap: {swapUsed:0.2f} GiB / {swapTotal:0.2f} GiB\n\nRMB: I/O Monitor", "states": {"warning": 70, "critical": 85}},
  "mod": "dock",
  "name": "waybar",
  "network": {"format-wifi": "\udb82\udd28", "format-ethernet": "\udb80\ude00", "format-disconnected": "\udb82\udd2d", "format-linked": "\udb80\ude01", "tooltip-format-wifi": "\udb82\udd28 {essid}\n\udb85\udc7d {signalStrength}%\n\udb82\ude5f {ipaddr}", "tooltip-format-ethernet": "\udb80\ude00 Ethernet\n\udb82\ude5f {ipaddr}", "tooltip-format-disconnected": "\udb82\udd2d Disconnected", "on-click": "foot --app-id=dusky_tui python $HOME/.local/bin/dusky/dusky_tui/python/main/main.py $HOME/.local/bin/dusky/network_manager/tui_dusky_network.py"},
  "passthrough": false,
  "position": "top",
  "pulseaudio": {"format": "{icon} {volume}%", "format-muted": "\udb81\udd81", "format-bluetooth": "\udb80\udcb0 {volume}%", "format-bluetooth-muted": "\udb80\udcb2", "format-icons": {"headphone": "\udb80\udecb", "hands-free": "\udb80\udece", "headset": "\udb80\udece", "phone": "", "portable": "", "car": "", "default": ["\udb81\udd7f", "\udb81\udd80", "\udb81\udd7e"]}, "on-click": "dusky-run pavucontrol", "on-click-right": "dusky-run kitty --class cava -e cava", "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle", "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%", "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%", "tooltip-format": "{desc}\nVolume: {volume}%\n\nLMB: Pavucontrol\nRMB: Cava\nMMB: Mute Toggle\nScroll: Volume", "scroll-step": 5, "max-volume": 150},
  "reload_style_on_change": true,
  "tray": {"icon-size": 15, "spacing": 6, "show-passive-items": true},
  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-center": ["group/updates-drawer", "clock", "custom/notification"],
  "modules-right": ["group/network-drawer", "cpu", "memory", "pulseaudio", "backlight", "battery", "tray", "group/power-drawer"],
}