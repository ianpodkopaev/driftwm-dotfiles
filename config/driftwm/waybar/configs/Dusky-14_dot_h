/* Dusky port | layout base */
{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    "$HOME/.config/waybar/ModulesVertical",
    "$HOME/.config/waybar/UserModules",
    "$HOME/.config/waybar/ModulesDusky",
    "$HOME/.config/waybar/dusky/ov_14_dot_h",
  ],

  "battery": {"states": {"good": 95, "warning": 30, "critical": 15}, "format": "{icon} {capacity}%", "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"]},
  "bluetooth": {"format": "\uf294", "format-connected": "\uf294 {num_connections}", "tooltip-format": "{controller_alias}\n{num_connections} connected", "on-click": "dusky-run blueman-manager"},
  "clock": {"format": "{:%I:%M %p}", "tooltip-format": "<tt>{calendar}</tt>", "calendar": {"mode": "month", "mode-mon-col": 3, "weeks-pos": "right", "on-scroll": 1, "format": {"months": "<span color='#ffb786'><b>{}</b></span>", "days": "<span color='#e2e2e2'>{}</span>", "weeks": "<span color='#c9ca93'>W{}</span>", "weekdays": "<span color='#ffb786'><b>{}</b></span>", "today": "<span color='#131313' background='#ffb786'><b>{}</b></span>"}}, "actions": {"on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down"}, "on-click": "dusky-run gnome-clocks"},
  "cpu": {"interval": 2, "format": "\uf2db {usage}%", "on-click": "dusky-run kitty -e btop"},
  "disk": {"interval": 30, "format": "\uf0a0 {percentage_used}%", "path": "/"},
  "height": 32,
  "layer": "top",
  "margin-left": 8,
  "margin-right": 8,
  "margin-top": 4,
  "memory": {"interval": 2, "format": "\uf0c9 {percentage}%"},
  "network": {"format-wifi": "\uf1eb", "format-ethernet": "\udb80\ude00", "format-disconnected": "\udb82\udd2d", "tooltip-format-wifi": "{essid} ({signalStrength}%)", "on-click": "foot --app-id=dusky_tui python $HOME/.local/bin/dusky/dusky_tui/python/main/main.py $HOME/.local/bin/dusky/network_manager/tui_dusky_network.py"},
  "position": "top",
  "reload_style_on_change": true,
  "spacing": 0,
  "temperature": {"thermal-zone": 8, "interval": 2, "format": "\uf2c9 {temperatureC}\u00b0C", "critical-threshold": 80},
  "modules-left": ["group/left-pill", "custom/notification", "group/updates-drawer"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["group/expandable", "group/network-drawer", "battery", "group/power-drawer"],
}