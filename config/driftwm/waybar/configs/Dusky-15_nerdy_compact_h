/* Dusky port | layout base */
{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    "$HOME/.config/waybar/ModulesVertical",
    "$HOME/.config/waybar/UserModules",
    "$HOME/.config/waybar/ModulesDusky",
    "$HOME/.config/waybar/dusky/ov_15_nerdy_compact_h",
  ],

  "backlight": {"device": "intel_backlight", "format": "{icon} {percent}%", "format-icons": ["\udb80\udcde", "\udb80\udcdf", "\udb80\udce0"], "tooltip-format": "Brightness: {percent}%\n\nLMB: Brightness Slider\nRMB: Hyprsunset Slider\nMMB: Shader Menu\nScroll: Adjust", "on-click": "dusky-run $HOME/.local/bin/dusky/dusky_system/quickpanal/dusky_quickpanal.py", "on-click-right": "dusky-run $HOME/.local/bin/dusky/dusky_system/quickpanal/dusky_quickpanal.py", "on-click-middle": "dusky-run $HOME/.local/bin/dusky/rofi/shader_menu.sh", "on-scroll-up": "brightnessctl set +5%", "on-scroll-down": "brightnessctl set 5%-", "interval": 60},
  "battery": {"format": "{icon} {capacity}%", "format-alt": "{icon} {capacity}% {power:.1f}W", "format-charging": "\udb80\udc84 {capacity}%", "format-plugged": "\udb80\udc84 {capacity}%", "format-full": "\udb85\udfe2", "format-warning": "{icon} {capacity}%", "format-critical": "\udb80\udc83 {capacity}%", "format-icons": ["\udb80\udc8e", "\udb80\udc7a", "\udb80\udc7b", "\udb80\udc7c", "\udb80\udc7d", "\udb80\udc7e", "\udb80\udc7f", "\udb80\udc80", "\udb80\udc81", "\udb80\udc82", "\udb80\udc79"], "interval": 5, "states": {"warning": 30, "critical": 15}, "tooltip-format": "{timeTo}\nHealth: {health}%\nPower Draw: {power:.2f} W\nCycles: {cycles}\n\nLMB: Toggle Format\nRMB: Timeout Settings", "on-click-right": "dusky-run kitty --class dusky_hypridle.sh -e $HOME/.local/bin/dusky/hypridle/dusky_hypridle.sh"},
  "bluetooth": {"format": "\udb80\udcaf", "format-on": "\udb80\udcaf", "format-off": "\udb80\udcb2", "format-disabled": "\udb80\udcb2", "format-connected": "\udb80\udcb1 {num_connections}", "format-connected-battery": "\udb80\udcb1 {device_battery_percentage}%", "tooltip-format": "{controller_alias}\n{controller_address}\n\nLMB: Blueman\nRMB: Bluetui", "tooltip-format-off": "Bluetooth OFF\n\nLMB: Blueman\nRMB: Bluetui", "tooltip-format-connected": "{controller_alias}\n{controller_address}\n\n{device_enumerate}\n\nLMB: Blueman\nRMB: Bluetui", "tooltip-format-enumerate-connected": " {device_alias}", "tooltip-format-enumerate-connected-battery": " {device_alias} ({device_battery_percentage}%)", "on-click": "dusky-run blueman-manager", "on-click-right": "dusky-run kitty --class bluetui -e bluetui", "interval": 5},
  "clock": {"format": "{:%I:%M %p}", "format-alt": " {:%A, %d %B %Y  \u2022  %I:%M:%S %p}", "tooltip-format": "<tt>{calendar}</tt>", "interval": 1, "calendar": {"mode": "year", "mode-mon-col": 3, "weeks-pos": "right", "on-scroll": 1, "format": {"months": "<span color='#ffead3'><b>{}</b></span>", "days": "<span color='#ecc6d9'><b>{}</b></span>", "weeks": "<span color='#99ffdd'><b>W{}</b></span>", "weekdays": "<span color='#ffcc66'><b>{}</b></span>", "today": "<span color='#ff6699'><b><u>{}</u></b></span>"}}, "actions": {"on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down"}, "on-click": "dusky-run gnome-clocks", "on-click-middle": "dusky-run kitty --class peaclock -e peaclock"},
  "cpu": {"format": " {usage}%", "interval": 2, "on-click": "dusky-run kitty --class htop -e htop", "on-click-right": "dusky-run kitty --class sysbench_benchmark.py -e $HOME/.local/bin/dusky/performance/sysbench_benchmark.py", "tooltip-format": "CPU Usage: {usage}%\nAvg Frequency: {avg_frequency} GHz\n\nLMB: htop\nRMB: sysbench", "states": {"warning": 60, "critical": 80}},
  "disk": {"format": "\udb80\udeca {percentage_used}%", "format-alt": "\udb80\udeca {used}/{total}", "path": "/", "interval": 60, "tooltip-format": "Disk Usage: {used}/{total} ({percentage_used}%)\nFree: {free}\nPath: {path}\n\nLMB: Toggle Format\nRMB: File Manager", "states": {"warning": 75, "critical": 90}, "on-click-right": "$HOME/.local/bin/dusky/waybar/launch_app.sh file-manager"},
  "exclusive": true,
  "fixed-center": true,
  "height": 28,
  "layer": "top",
  "margin-bottom": 0,
  "margin-left": 4,
  "margin-right": 4,
  "margin-top": 2,
  "memory": {"format": "\udb80\udf5b {percentage}%", "format-alt": "\udb80\udf5b {used:0.1f}G", "interval": 3, "on-click-right": "dusky-run kitty --class dusky_disk_monitor_io.py -e $HOME/.local/bin/dusky/drives/dusky_disk_monitor_io.py", "tooltip-format": "RAM: {used:0.2f} GiB / {total:0.2f} GiB ({percentage}%)\nAvailable: {avail:0.2f} GiB\nSwap: {swapUsed:0.2f} GiB / {swapTotal:0.2f} GiB\n\nRMB: I/O Monitor", "states": {"warning": 70, "critical": 85}},
  "network": {"format": "{ifname}", "format-wifi": "{icon} {signalStrength}%", "format-ethernet": "\udb80\ude00", "format-linked": "\udb80\ude00 No IP", "format-disconnected": "\udb82\udd2d", "format-disabled": "\udb80\udc1d", "format-icons": ["\udb82\udd2f", "\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28"], "tooltip-format-wifi": " {essid}\n\nSignal: {signalStrength}% ({signaldBm} dBm)\nFrequency: {frequency} MHz\nInterface: {ifname}\nIP: {ipaddr}/{cidr}\n\n\udb81\udd52 {bandwidthUpBytes}  \udb80\uddda {bandwidthDownBytes}\n\nLMB: Dusky Network\nRMB: WiFi ON\nMMB: WiFi OFF", "tooltip-format-ethernet": "\udb80\ude00 Wired Connected\n\nInterface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}\n\n(Speed shown in center meter)", "tooltip-format-disconnected": "No connection\n\nRMB: Turn WiFi ON", "interval": 2, "on-click": "foot --app-id=dusky_tui python $HOME/.local/bin/dusky/dusky_tui/python/main/main.py $HOME/.local/bin/dusky/network_manager/tui_dusky_network.py", "on-click-right": "nmcli radio wifi on && notify-send 'WiFi' 'Turned ON'", "on-click-middle": "nmcli radio wifi off && notify-send 'WiFi' 'Turned OFF'"},
  "position": "top",
  "privacy": {"icon-spacing": 2, "icon-size": 12, "transition-duration": 250, "modules": [{"type": "screenshare", "tooltip": true, "tooltip-icon-size": 14}, {"type": "audio-in", "tooltip": true, "tooltip-icon-size": 14}, {"type": "audio-out", "tooltip": true, "tooltip-icon-size": 14}]},
  "pulseaudio": {"format": "{icon} {volume}%", "format-muted": "\udb81\udd81", "format-bluetooth": "\udb80\udcb0 {volume}%", "format-bluetooth-muted": "\udb80\udcb2", "format-icons": {"headphone": "\udb80\udecb", "hands-free": "\udb80\udece", "headset": "\udb80\udece", "phone": "", "portable": "", "car": "", "default": ["\udb81\udd7f", "\udb81\udd80", "\udb81\udd7e"]}, "on-click": "dusky-run pavucontrol", "on-click-right": "dusky-run kitty --class cava -e cava", "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle", "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%", "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%", "tooltip-format": "{desc}\nVolume: {volume}%\n\nLMB: Pavucontrol\nRMB: Cava\nMMB: Mute Toggle\nScroll: Volume", "scroll-step": 5, "max-volume": 150},
  "reload_style_on_change": true,
  "spacing": 0,
  "temperature": {"thermal-zone": 6, "format": "{icon} {temperatureC}\u00b0", "format-icons": ["\udb84\udcc3", "\udb81\udd0f", "\udb84\udcc2"], "critical-threshold": 75, "format-critical": "\udb83\ude01 {temperatureC}\u00b0", "tooltip-format": "CPU Package: {temperatureC}\u00b0C / {temperatureF}\u00b0F\nThermal Zone: 6", "interval": 3},
  "tray": {"icon-size": 14, "spacing": 4, "show-passive-items": true},
  "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/submap", "hyprland/window"],
  "modules-center": ["custom/net-speed", "clock", "group/updates-drawer", "privacy"],
  "modules-right": ["cpu", "memory", "disk", "temperature", "custom/separator", "backlight", "network", "bluetooth", "pulseaudio", "battery", "custom/separator-2", "custom/theme", "custom/inhibit-suspend", "custom/notification", "tray", "custom/power"],
}