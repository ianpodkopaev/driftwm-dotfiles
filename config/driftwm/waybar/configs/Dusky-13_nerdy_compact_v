/* Dusky port | layout base */
{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    "$HOME/.config/waybar/ModulesVertical",
    "$HOME/.config/waybar/UserModules",
    "$HOME/.config/waybar/ModulesDusky",
    "$HOME/.config/waybar/dusky/ov_13_nerdy_compact_v",
  ],

  "backlight": {"justify": "center", "align": 0.5, "device": "intel_backlight", "format": "{icon}\n{percent}", "format-icons": ["\ue38d", "\ue3d4", "\ue3d3", "\ue3d2", "\ue3d1", "\ue3d0", "\ue3cf", "\ue3ce", "\ue3cd", "\ue3cc", "\ue3cb", "\ue3ca", "\ue3c9", "\ue3c8", "\ue39b"], "tooltip": true, "tooltip-format": "LMB: Brightness Slider\nRMB: hyprsunset Slider\nMMB: Shaders", "on-click": "dusky-run \"$HOME/.local/bin/dusky/dusky_system/quickpanal/dusky_quickpanal.py\"", "on-click-right": "dusky-run \"$HOME/.local/bin/dusky/dusky_system/quickpanal/dusky_quickpanal.py\"", "on-click-middle": "dusky-run \"$HOME/.local/bin/dusky/rofi/shader_menu.sh\"", "on-scroll-up": "brightnessctl set +5%", "on-scroll-down": "brightnessctl set 5%-", "min-length": 4, "interval": 60},
  "battery": {"justify": "center", "align": 0.5, "format": "{icon}\n{capacity}\n{power:.0f}W", "format-charging": "\uf0e7\n+{capacity}\n{power:.0f}W", "format-plugged": "\uf1e6\n{capacity}", "format-icons": ["\udb80\udc8e", "\udb80\udc7a", "\udb80\udc7b", "\udb80\udc7c", "\udb80\udc7d", "\udb80\udc7e", "\udb80\udc7f", "\udb80\udc80", "\udb80\udc81", "\udb80\udc82", "\udb80\udc79"], "interval": 10, "states": {"warning": 40, "critical": 20}, "tooltip-format": "{timeTo}\nHealth \udb85\udfe6 {health}%\nPower Draw {power:.2f} W", "on-click": "dusky-run kitty --class power_saver.sh --hold -e \"$HOME/.local/bin/dusky/battery/power_saver.sh\" --interactive", "on-click-right": "dusky-run kitty --class dusky_hypridle.sh -e \"$HOME/.local/bin/dusky/hypridle/dusky_hypridle.sh\""},
  "bluetooth": {"justify": "center", "align": 0.5, "format": "\uf294", "format-disabled": "\udb80\udcb2", "format-connected": "\uf294", "tooltip-format": "Devices connected: {num_connections}", "on-click": "dusky-run blueman-manager", "on-click-right": "dusky-run kitty --class bluetui -e bluetui"},
  "clock": {"justify": "center", "align": 0.5, "format": "{:%I\n%M}", "tooltip-format": "<tt>{calendar}</tt>", "interval": 60, "on-click": "dusky-run gnome-clocks", "on-click-middle": "dusky-run kitty --class peaclock -e peaclock", "calendar": {"mode": "year", "mode-mon-col": 3, "weeks-pos": "right", "on-scroll": 1, "on-click-right": "mode", "format": {"months": "<span color='#ffead3'><b>{}</b></span>", "days": "<span color='#ecc6d9'><b>{}</b></span>", "weeks": "<span color='#99ffdd'><b>W{}</b></span>", "weekdays": "<span color='#ffcc66'><b>{}</b></span>", "today": "<span color='#ff6699'><b><u>{}</u></b></span>"}}, "actions": {"on-click-right": "mode", "on-scroll-up": "shift_up", "on-scroll-down": "shift_down"}},
  "cpu": {"justify": "center", "align": 0.5, "format": "\uec19\n{usage}", "tooltip": true, "on-click": "dusky-run kitty --class htop -e htop", "on-click-right": "dusky-run kitty --class sysbench_benchmark.py -e \"$HOME/.local/bin/dusky/performance/sysbench_benchmark.py\"", "tooltip-format": "CPU: {usage}%\nAvg Freq: {avg_frequency}GHz", "interval": 2},
  "fixed-center": true,
  "layer": "top",
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-top": 0,
  "memory": {"justify": "center", "align": 0.5, "format": "\uf080\n{percentage}", "interval": 2, "on-click": "dusky-run kitty --class dusky_disk_monitor_io.py -e \"$HOME/.local/bin/dusky/drives/dusky_disk_monitor_io.py\"", "states": {"critical": 80}, "tooltip": true, "tooltip-format": "Used {used} GiB\nAvail {avail} Gib\nSwap {swapUsed} GiB"},
  "position": "left",
  "pulseaudio": {"justify": "center", "align": 0.5, "format": "{icon}\n{volume}", "format-muted": "\udb81\udd81", "on-click": "dusky-run pavucontrol", "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle", "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%", "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%", "format-icons": ["\udb81\udd81", "\uf027", "\uf028"], "tooltip": true, "tooltip-format": "{desc}\n\nLMB: pavucontrol\nRMB: cava\nMMB: Mute"},
  "reload_style_on_change": true,
  "spacing": 0,
  "temperature": {"justify": "center", "align": 0.5, "thermal-zone": 6, "critical-threshold": 65, "format-critical": "\ud83d\udd25\n{temperatureC}", "format": "\uf2c9\n{temperatureC}", "interval": 2, "tooltip-format": "Package: {temperatureC}\u00b0C"},
  "tray": {"icon-size": 18, "show-passive-items": true, "spacing": 1, "rotate": 90},
  "width": 10,
  "modules-left": ["battery", "group/media", "group/hardware"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["group/updates-drawer", "custom/notification", "custom/theme", "group/connections", "clock", "tray", "custom/inhibit-suspend", "custom/power"],
}