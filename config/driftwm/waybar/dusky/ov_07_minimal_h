// 07_minimal_h variant overrides
{
  "group/clock-drawer": {"orientation": "horizontal", "drawer": {"transition-duration": 400, "children-class": "clock-drawer", "click-to-reveal": false, "transition-left-to-right": true}, "modules": ["clock", "custom/weather", "custom/net-speed"]},
  "group/audio-drawer": {"orientation": "horizontal", "drawer": {"transition-duration": 400, "children-class": "audio-drawer", "click-to-reveal": false, "transition-left-to-right": false}, "modules": ["pulseaudio", "bluetooth", "network"]},
  "group/battery-drawer": {"orientation": "horizontal", "drawer": {"transition-duration": 400, "children-class": "battery-drawer", "click-to-reveal": false, "transition-left-to-right": false}, "modules": ["battery", "cpu", "memory"]},
  "group/power-drawer": {"orientation": "horizontal", "drawer": {"transition-duration": 400, "children-class": "power-drawer", "click-to-reveal": false, "transition-left-to-right": false}, "modules": ["custom/power", "custom/inhibit-suspend"]},
  "hyprland/workspaces": {"format": "", "on-click": "activate", "sort-by": "number", "persistent-workspaces": {}, "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"},
  "custom/weather": {"format": "{}", "exec": "python3 $HOME/.local/bin/dusky/waybar/weather.py", "interval": 1800, "return-type": "json"},
  "custom/notification": {"format": "{}", "return-type": "json", "exec-if": "which makoctl", "exec": "$HOME/.local/bin/dusky/waybar/mako.sh --horizontal", "interval": 2, "tooltip-format": "Left Click: Launch Mako\nMiddle Click: Clear All\nRight Click: Do Not Disturb", "on-click": "$HOME/.local/bin/dusky/rofi/rofi_mako.sh", "on-click-middle": "$HOME/.local/bin/dusky/waybar/mako.sh --clear && pkill -RTMIN+8 waybar", "on-click-right": "makoctl mode -t do-not-disturb && pkill -RTMIN+8 waybar", "signal": 8, "escape": true},
  "custom/updates": {"exec": "tail -F ~/.config/dusky/settings/waybar_update_counter_h 2>/dev/null", "return-type": "json", "format": "{}", "tooltip": true, "on-click": "dusky-run kitty --class system_update.sh --hold -e $HOME/.local/bin/dusky/update_dusky/system_update.sh --all"},
  "custom/power": {"format": "\udb81\udc25", "tooltip-format": "Power Menu\nRight-click: Control Center", "on-click": "dusky-run $HOME/.local/bin/dusky/wlogout/wlogout_scale.sh", "on-click-right": "dusky-run python3 $HOME/.local/bin/dusky/dusky_system/control_center/dusky_control_center.py"},
  "custom/inhibit-suspend": {"format": "{}", "exec": "if pgrep -x 'hypridle' > /dev/null; then echo '{\"text\": \"\udb83\udfaa\", \"tooltip\": \"Idle enabled. Click to disable.\", \"class\": \"enabled\"}'; else echo '{\"text\": \"\udb80\udd76\", \"tooltip\": \"Idle disabled. Click to enable.\", \"class\": \"disabled\"}'; fi", "return-type": "json", "interval": 5, "signal": 9, "on-click": "dusky-run $HOME/.local/bin/dusky/waybar/toggle_hypridle.sh", "escape": true},
}