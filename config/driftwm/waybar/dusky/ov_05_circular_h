// 05_circular_h variant overrides
{
  "custom/arch": {"format": "\udb80\udf3d", "tooltip-format": "Control Center", "on-click": "dusky-run python3 $HOME/.local/bin/dusky/dusky_system/control_center/dusky_control_center.py", "on-click-right": "gdbus call --session --dest org.dusky.quickpanal --object-path /org/dusky/quickpanal --method org.freedesktop.Application.Activate '{}'"},
  "custom/lock": {"format": "\udb80\udf3e", "tooltip-format": "Lock Screen", "on-click": "dusky-run $HOME/.local/bin/dusky/hyprlock/lock.sh"},
  "custom/inhibit-suspend": {"format": "{}", "exec": "if pgrep -x 'hypridle' > /dev/null; then echo '{\"text\": \"\udb83\udfaa\", \"tooltip\": \"Idle enabled. Click to disable.\", \"class\": \"enabled\"}'; else echo '{\"text\": \"\udb80\udd76\", \"tooltip\": \"Idle disabled. Click to enable.\", \"class\": \"disabled\"}'; fi", "return-type": "json", "interval": 5, "signal": 9, "on-click": "dusky-run $HOME/.local/bin/dusky/waybar/toggle_hypridle.sh", "escape": true},
  "custom/reboot": {"format": "\udb81\udf09", "tooltip-format": "Reboot", "on-click": "systemctl reboot"},
  "group/updates-drawer": {"orientation": "horizontal", "drawer": {"transition-duration": 400, "children-class": "updates-drawer", "transition-left-to-right": true}, "modules": ["custom/updates-trigger", "custom/updates"]},
  "custom/updates-trigger": {"format": "\uf063", "exec": "echo '\uf063'", "exec-if": "grep -q '\"class\":\"pending\"' ~/.config/dusky/settings/waybar_update_counter_h 2>/dev/null", "interval": 5, "tooltip": false},
  "custom/updates": {"exec": "tail -F ~/.config/dusky/settings/waybar_update_counter_h 2>/dev/null", "return-type": "json", "format": "{}", "tooltip": true, "on-click": "dusky-run kitty --class system_update.sh --hold -e $HOME/.local/bin/dusky/update_dusky/system_update.sh --all"},
  "hyprland/workspaces": {"format": "{icon}", "format-icons": {"active": "\udb82\udfaf", "visible": "\uf444", "default": "\u2022", "persistent": "\u2022"}, "on-click": "activate", "persistent-workspaces": {"*": 5}, "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"},
  "custom/notification": {"format": "{}", "return-type": "json", "exec-if": "which makoctl", "exec": "$HOME/.local/bin/dusky/waybar/mako.sh", "on-click": "$HOME/.local/bin/dusky/rofi/rofi_mako.sh", "on-click-middle": "$HOME/.local/bin/dusky/waybar/mako.sh --clear && pkill -RTMIN+8 waybar", "on-click-right": "makoctl mode -t do-not-disturb && pkill -RTMIN+8 waybar", "signal": 8, "escape": true, "tooltip-format": "Notifications\n\n LMB  Toggle Panel\n MMB  Clear All\n RMB  Do Not Disturb"},
}