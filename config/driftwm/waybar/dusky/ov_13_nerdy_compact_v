// 13_nerdy_compact_v variant overrides
{
  "group/updates-drawer": {"orientation": "inherit", "drawer": {"transition-duration": 400, "children-class": "updates-drawer", "click-to-reveal": false, "transition-left-to-right": true}, "modules": ["custom/updates-trigger", "custom/updates"]},
  "hyprland/workspaces": {"on-click": "activate", "all-outputs": true, "sort-by": "number", "format": "{id}", "persistent-workspaces": {"*": 5}, "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'", "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"},
  "custom/network": {"justify": "center", "align": 0.5, "return-type": "json", "tooltip": true, "tooltip-format": "LMB: Dusky Network\nRMB: WiFi ON\nMMB: WiFi OFF", "on-click": "foot --app-id=dusky_tui python $HOME/.local/bin/dusky/dusky_tui/python/main/main.py $HOME/.local/bin/dusky/network_manager/tui_dusky_network.py", "on-click-right": "systemctl --user restart network_meter.service && nmcli radio wifi on && notify-send 'Turned ON WiFi'", "on-click-middle": "nmcli radio wifi off && notify-send 'Turned OFF WiFi'", "interval": 2, "exec": "$HOME/.local/bin/dusky/waybar/network/network_meter_calling.sh --vertical"},
  "custom/updates-trigger": {"justify": "center", "align": 0.5, "format": "\uf063", "exec": "echo '\uf063'", "exec-if": "grep -q '\"class\":\"pending\"' ~/.config/dusky/settings/waybar_update_counter_v 2>/dev/null", "interval": 5, "tooltip": false},
  "custom/updates": {"justify": "center", "align": 0.5, "exec": "tail -F ~/.config/dusky/settings/waybar_update_counter_v 2>/dev/null", "return-type": "json", "format": "{}", "tooltip": true, "on-click": "dusky-run kitty --class system_update.sh --hold -e $HOME/.local/bin/dusky/update_dusky/system_update.sh --all"},
  "custom/notification": {"justify": "center", "align": 0.5, "tooltip-format": "Left Click: Launch Mako\nMiddle Click: Clear All\nRight Click: Do Not Disturb", "format": "{}", "return-type": "json", "exec-if": "which makoctl", "exec": "$HOME/.local/bin/dusky/waybar/mako.sh --vertical", "interval": 2, "on-click": "$HOME/.local/bin/dusky/rofi/rofi_mako.sh", "on-click-middle": "$HOME/.local/bin/dusky/waybar/mako.sh --clear && pkill -RTMIN+8 waybar", "on-click-right": "makoctl mode -t do-not-disturb && pkill -RTMIN+8 waybar", "signal": 8, "escape": true},
  "custom/inhibit-suspend": {"justify": "center", "align": 0.5, "format": "{}", "exec": "if pgrep -x 'hypridle' > /dev/null;\nthen echo '{\"text\": \"\udb80\udf3e\", \"tooltip\": \"Suspend is enabled.\\nClick to disable.\", \"class\": \"enabled\"}';\nelse echo '{\"text\": \"\uf52a\", \"tooltip\": \"Suspend is disabled.\\nClick to enable.\", \"class\": \"disabled\"}';\nfi", "return-type": "json", "interval": 5, "signal": 9, "on-click": "dusky-run \"$HOME/.local/bin/dusky/waybar/toggle_hypridle.sh\"", "escape": true},
  "custom/theme": {"justify": "center", "align": 0.5, "format": "\ue3dc", "tooltip": true, "tooltip-format": "Switch wallpapers\nLMB: Dark Mode\nRMB: Light Mode\nMMB: Wallpaper Selector", "on-click": "dusky-run \"$HOME/.local/bin/dusky/theme_matugen/theme_ctl.sh\" set --mode dark", "on-click-right": "dusky-run \"$HOME/.local/bin/dusky/theme_matugen/theme_ctl.sh\" set --mode light", "on-click-middle": "dusky-run $HOME/.local/bin/dusky/images/wallpaper_selector.py"},
  "custom/power": {"justify": "center", "align": 0.5, "format": "\uf011", "tooltip": true, "tooltip-format": "Power Menu", "on-click": "dusky-run \"$HOME/.local/bin/dusky/wlogout/wlogout_scale.sh\""},
}