#!/usr/bin/env bash
# driftwm-bookmark — bookmark jump with a "previous bookmark" memory.
#   driftwm-bookmark N          super+N: jump to N, or bounce back to where you
#                               came from if the camera is already on N.
#   driftwm-bookmark --jump N   click: always jump to N, remembering the old one.
# The previous target lives in ~/.cache so super+N toggles between two bookmarks.
set -uo pipefail

jump=0
if [ "${1:-}" = --jump ]; then jump=1; shift; fi
n="${1:-}"
if [ -z "$n" ]; then
    echo "usage: driftwm-bookmark [--jump] N" >&2
    exit 2
fi

cache="${XDG_CACHE_HOME:-$HOME/.cache}/driftwm-bookmark-prev"
cur=$(driftwm msg state --json 2>/dev/null | jq -r '.Ok.State.active_bookmark // empty')

# toggle mode: already on N -> go back to the bookmark we came from
if [ "$jump" -eq 0 ] && [ "$cur" = "$n" ]; then
    prev=$(cat "$cache" 2>/dev/null || true)
    if [ -n "$prev" ] && [ "$prev" != "$n" ]; then
        driftwm msg action "go-to-bookmark $prev" >/dev/null 2>&1
    fi
    exit 0
fi

# jumping somewhere else -> remember where we were, then go
if [ -n "$cur" ] && [ "$cur" != "$n" ]; then
    printf '%s' "$cur" > "$cache"
fi
driftwm msg action "go-to-bookmark $n" >/dev/null 2>&1
