#!/usr/bin/env bash
# lock-screen — lock the session with hyprlock (ext-session-lock).
# Uses driftwm's self-contained config, the same one the ctrl+alt+l binding
# spawns, so idle auto-lock, the bar's lock button and the keybinding all look
# identical. hyprlock blurs the wallpaper itself, so there is nothing to rebuild.
set -uo pipefail

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
conf="$cfg/driftwm/hyprlock.conf"

if ! command -v hyprlock >/dev/null 2>&1; then
    notify-send -u critical "Lockscreen unavailable" \
        "hyprlock is not installed — run: sudo pacman -S hyprlock"
    echo "lock-screen: hyprlock not installed (sudo pacman -S hyprlock)" >&2
    exit 1
fi

pidof hyprlock >/dev/null && exit 0

exec hyprlock -c "$conf"
