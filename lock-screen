#!/usr/bin/env bash
# lock-screen — lock the session with gtklock (ext-session-lock).
# Rebuilds the blurred lock background from driftwm's wallpaper when the
# config changes, so the lock screen matches the desktop the way hyprlock's
# `background { blur_passes = 2 }` does.
set -uo pipefail

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
img="$cfg/gtklock/background.jpg"

if ! command -v gtklock >/dev/null 2>&1; then
    notify-send -u critical "Lockscreen unavailable" \
        "gtklock is not installed — run: sudo pacman -S gtklock"
    echo "lock-screen: gtklock not installed (sudo pacman -S gtklock)" >&2
    exit 1
fi

if [ ! -f "$img" ] || [ "$cfg/driftwm/config.toml" -nt "$img" ]; then
    wall=$(sed -n 's/^path *= *"\(.*\)"/\1/p' "$cfg/driftwm/config.toml" 2>/dev/null | head -1)
    wall="${wall/#\~/$HOME}"
    if [ -f "$wall" ]; then
        magick "$wall" -resize 1920x1080^ -gravity center -extent 1920x1080 \
               -blur 0x18 "$img" 2>/dev/null
    fi
fi

pidof gtklock >/dev/null && exit 0

# gtklock gives the password form to the first window it creates, and windows
# follow GDK's monitor order — which put the form on the idle output. Put the
# output that actually has the cursor first via -M.
out=$(driftwm msg state --json 2>/dev/null |
      jq -r '.Ok.State.outputs[] | select(.active) | .name' 2>/dev/null | head -1)
args=()
[ -n "$out" ] && args=(-M "$out")

exec gtklock "${args[@]}"
